# Copy to .env and fill in. Never commit .env.

# --- Database (read by both the postgis image and Django) ---
POSTGRES_DB=food_trucks
POSTGRES_USER=food_trucks
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Laptop: localhost,127.0.0.1   EC2: your domain, e.g. trucks.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# EC2 only, e.g. https://trucks.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# EC2 with HTTPS: true (login cookies only travel over HTTPS). Laptop: false.
DJANGO_SECURE_COOKIES=false

# Sign-up attempts allowed per IP address. Blank = 5/hour. Format: <number>/<second|minute|hour|day>
# Everyone on one Wi-Fi network shares an IP, so raise it for a classroom demo (e.g. 50/hour).
REGISTER_THROTTLE_RATE=

# --- Caddy (production only) ---
# A domain gets automatic HTTPS. ":80" = plain HTTP for a quick test.
SITE_ADDRESS=:80

# --- Map tiles (optional) ---
# Blank = OpenStreetMap public tiles (dev only). Set a hosted provider URL for production.
VITE_TILE_URL=

# --- Place search (optional) ---
# Nominatim requires a User-Agent naming the app plus a contact; blank = built-in default.
NOMINATIM_USER_AGENT=
# Limit place results to these countries (comma-separated ISO codes). Default: us
PLACE_SEARCH_COUNTRY_CODES=us

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=